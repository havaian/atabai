{
  "name": "atabai-frontend",
  "version": "2.0.0",
  "description": "ATABAI Frontend - Vue 3 + TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "lint": "eslint . --ext .vue,.ts,.tsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue3",
    "typescript",
    "excel",
    "ifrs",
    "frontend",
    "tailwind",
    "spreadsheet",
    "automation"
  ],
  "author": "ATABAI Team",
  "license": "MIT",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@headlessui/vue": "^1.7.19",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/forms": "^0.5.7",
    "@unhead/vue": "^2.0.12",
    "@univerjs/core": "^0.20.0",
    "@univerjs/design": "^0.20.0",
    "@univerjs/docs": "^0.20.0",
    "@univerjs/docs-ui": "^0.20.0",
    "@univerjs/engine-formula": "^0.20.0",
    "@univerjs/engine-render": "^0.20.0",
    "@univerjs/sheets": "^0.20.0",
    "@univerjs/sheets-formula": "^0.20.0",
    "@univerjs/sheets-formula-ui": "^0.20.0",
    "@univerjs/sheets-ui": "^0.20.0",
    "@univerjs/ui": "^0.20.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.45.0",
    "@vue-flow/minimap": "^1.5.3",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.7",
    "date-fns": "^3.6.0",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.548.0",
    "marked": "^15.0.11",
    "pinia": "^2.1.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.16.0",
    "unhead": "^2.0.12",
    "vue": "^3.4.19",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.3.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.7.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.1",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.3",
    "vite": "^7.3.7",
    "vue-tsc": "^2.2.0"
  }
}
